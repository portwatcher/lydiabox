# LydiaBox self-hosted configuration.
#
# Copy to .env, fill the required S3 settings, then run:
#   set -a; . ./.env; set +a; ./lydiabox up
#
# Most variables can also be set in lydiabox.yaml (keys in the "yaml:"
# comments). Environment variables override lydiabox.yaml, which overrides
# the defaults. Variables marked "env only" have no YAML key.

# Path of the YAML configuration file. `lydiabox up --config FILE` overrides
# it. A missing default file is not an error; a missing explicit file is.
# env only                                             default: ./lydiabox.yaml
#LYDIABOX_CONFIG=./lydiabox.yaml

# --- Server ---------------------------------------------------------------

# Address of the web UI, REST API, WebSocket, and /webdav endpoints.
# When `lydiabox cloudflare setup` saved a tunnel and this is not set, the
# default is 127.0.0.1:8080, so that only the tunnel reaches the server.
# Any value set here (also 0.0.0.0:8080) turns that off.
# yaml: listen_addr                                    default: 0.0.0.0:8080
#LYDIABOX_LISTEN_ADDR=0.0.0.0:8080

# Admin password for the web UI and API (Bearer token, session cookie, or
# WebDAV Basic Auth password with user "lydiabox"). At least 16 characters.
# When unset, a random token is generated, saved to
# $LYDIABOX_DATA_DIR/state/auth.token (mode 0600), and printed on first boot.
# yaml: auth_token                                     default: auto-generated
#LYDIABOX_AUTH_TOKEN=

# 32-byte hex key (64 hex characters) that encrypts OAuth tokens with
# AES-256-GCM. When unset, it is generated and saved to
# $LYDIABOX_DATA_DIR/state/master.key (mode 0600). Back this file up: losing
# it makes stored connector tokens unreadable. Generate one with:
#   openssl rand -hex 32
# yaml: master_key                                     default: auto-generated
#LYDIABOX_MASTER_KEY=

# Host runtime binaries, caches, SQLite metadata, and the JuiceFS mount.
# yaml: data_dir                                       default: ~/.lydiabox
#LYDIABOX_DATA_DIR=~/.lydiabox

# Log level: debug, info, warn, or error.
# yaml: log_level                                      default: info
#LYDIABOX_LOG_LEVEL=info

# --- S3 storage (required) ------------------------------------------------
# The bucket stores the JuiceFS data blocks and, under .lydiabox-system/,
# the metadata backups that restore the filesystem on a new host.

# S3, Cloudflare R2, or MinIO endpoint URL.
# yaml: s3.endpoint                                    required
LYDIABOX_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Region. R2 uses "auto"; AWS needs the bucket region (for example us-east-1).
# yaml: s3.region                                      default: auto
LYDIABOX_S3_REGION=auto

# Bucket name.
# yaml: s3.bucket                                      required
LYDIABOX_S3_BUCKET=lydiabox

# Access key ID and secret access key.
# yaml: s3.access_key / s3.secret_key                  required
LYDIABOX_S3_ACCESS_KEY=
LYDIABOX_S3_SECRET_KEY=

# Optional JuiceFS --bucket URL. By default it is derived from the endpoint:
# https://<bucket>.s3.<region>.amazonaws.com for AWS, <endpoint>/<bucket>
# (path style) for other S3-compatible services.
# yaml: s3.bucket_url                                  default: derived
#LYDIABOX_S3_BUCKET_URL=

# Backend address of the virtual S3 gateway (`juicefs gateway`). Clients do
# not use it: LYDIABOX_LISTEN_ADDR serves it at /s3 (the proxy verifies the
# SigV4 signature, removes /s3, and signs the request again). Use the
# endpoint http://<host>:8080/s3, the bucket "lydiabox" (keys workspace/...
# and home/agent/...), path-style addressing, access key "lydiabox", and
# secret key = LYDIABOX_AUTH_TOKEN. An empty value or "off" disables it.
# yaml: s3.gateway_addr                                default: 127.0.0.1:8090
#LYDIABOX_S3_GATEWAY_ADDR=127.0.0.1:8090

# Interval of the JuiceFS metadata and state database backup to S3. Snapshots
# are uploaded only when they changed. Minimum 5s.
# yaml: meta_sync_interval                             default: 60s
#LYDIABOX_META_SYNC_INTERVAL=60s

# --- Agent VM -------------------------------------------------------------

# VM backend: auto (chv when /dev/kvm is accessible, else docker), chv, or docker.
# yaml: vm.driver                                      default: auto
#LYDIABOX_VM_DRIVER=auto

# Guest vCPU count.
# yaml: vm.cpus                                        default: 4
#LYDIABOX_VM_CPUS=4

# Guest RAM in MiB (minimum 512).
# yaml: vm.mem_mb                                      default: 8192
#LYDIABOX_VM_MEM_MB=8192

# Optional host VFIO PCI address passed to Cloud Hypervisor for Blender GPU
# rendering, for example 0000:01:00.0.
# yaml: vm.gpu_pci_addr                                default: empty
#LYDIABOX_GPU_PCI_ADDR=

# Pause or stop the VM when no Harness PTY or Desktop stream is active for
# this long. 0 disables the idle timeout.
# yaml: vm.idle_timeout                                default: 20m
#LYDIABOX_IDLE_TIMEOUT=20m

# UDP port that carries all desktop WebRTC media. The VMM driver forwards it
# from the host to the guest (chv: nftables DNAT; docker: published port), so
# browsers need UDP access to it. 0 disables forwarding.
# env only                                             default: 50000
#LYDIABOX_WEBRTC_UDP_PORT=50000

# --- Desktop stream ICE (STUN and TURN) -----------------------------------
# A TURN relay carries the desktop stream when browsers cannot reach the UDP
# port above, for example behind a Cloudflare Tunnel with no inbound port.
# The browser and the guest peer get the same servers; the guest keeps the
# credentials in memory only. With the chv driver the guest cannot reach
# private networks or the host, so the TURN server needs a public address.
# With no setting in this section, the browser gets the Google STUN server
# and the guest gets none.

# STUN URLs, comma separated. "none" disables STUN.
# yaml: webrtc.stun_urls (list)                        default: stun:stun.l.google.com:19302
#LYDIABOX_STUN_URLS=stun:stun.l.google.com:19302

# TURN URLs, comma separated: turn:host:port?transport=udp|tcp or
# turns:host:port?transport=tcp (TLS) for networks that block UDP.
# yaml: webrtc.turn_urls (list)                        default: empty
#LYDIABOX_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:443?transport=tcp

# Static TURN credentials of LYDIABOX_TURN_URLS.
# yaml: webrtc.turn_username, webrtc.turn_password     default: empty
#LYDIABOX_TURN_USERNAME=
#LYDIABOX_TURN_PASSWORD=

# TURN REST shared secret (coturn: use-auth-secret, static-auth-secret).
# The host mints a credential for each viewer that expires after
# LYDIABOX_TURN_TTL. Use it instead of the static credentials.
# yaml: webrtc.turn_secret                             default: empty
#LYDIABOX_TURN_SECRET=

# Cloudflare Realtime TURN key ID and API token (Cloudflare dashboard:
# Realtime > TURN Server). The host mints credentials for each viewer and
# revokes them when the viewer leaves. The response includes Cloudflare's
# STUN server, so the default STUN server is not added.
# yaml: webrtc.cloudflare_turn_key_id, webrtc.cloudflare_turn_api_token
#LYDIABOX_CLOUDFLARE_TURN_KEY_ID=
#LYDIABOX_CLOUDFLARE_TURN_API_TOKEN=

# Lifetime of minted TURN credentials (1m to 48h). Before they expire, the
# host renews the stream with new credentials (a short video pause).
# yaml: webrtc.turn_ttl                                default: 1h
#LYDIABOX_TURN_TTL=1h

# Relay-only: both peers use only TURN relay candidates, so a tunnel-only
# host does not wait for direct candidates to fail. Needs a TURN server.
# Set LYDIABOX_WEBRTC_UDP_PORT=0 with it to forward no UDP port.
# yaml: webrtc.relay_only                              default: false
#LYDIABOX_WEBRTC_RELAY_ONLY=false

# Linux lydiabox-guest binary injected into the VM or container. By default
# it is found next to the lydiabox executable (make build: dist/), in
# $LYDIABOX_DATA_DIR/runtime/bin, or on PATH.
# env only                                             default: auto
#LYDIABOX_GUEST_BINARY=

# Desktop image of the docker VM driver, built with
#   deploy/rootfs/build-artifacts.sh --docker-image lydiabox/guest:latest --no-vm-images
# env only                                             default: lydiabox/guest:latest
#LYDIABOX_DOCKER_IMAGE=lydiabox/guest:latest

# LLM gateway that guest harness traffic (http://127.0.0.1:3425 in the VM)
# is forwarded to.
# env only                                             default: http://127.0.0.1:3425
#LYDIABOX_GATEWAY_UPSTREAM=http://127.0.0.1:3425

# Base URL of prebuilt guest images (vmlinux, initramfs.cpio.gz,
# rootfs.squashfs, and SHA256SUMS). When unset, build them locally with
# `lydiabox runtime build-rootfs`.
# yaml: rootfs_url                                     default: empty
#LYDIABOX_ROOTFS_URL=

# --- Runtime binary mirrors -----------------------------------------------
# Override the pinned download of a runtime binary (juicefs,
# cloud-hypervisor, virtiofsd, magpie, cloudflared). NAME is the binary name in upper case
# with "-" replaced by "_". The URL may be http(s):// or file:// and must
# serve the same artifact format as the pinned source unless it is a raw
# executable. Set the _SHA256 variable when the mirror serves a different file.
#LYDIABOX_MIRROR_JUICEFS=https://mirror.example.com/juicefs-1.4.2-linux-amd64.tar.gz
#LYDIABOX_MIRROR_JUICEFS_SHA256=
#LYDIABOX_MIRROR_CLOUD_HYPERVISOR=
#LYDIABOX_MIRROR_CLOUD_HYPERVISOR_SHA256=
#LYDIABOX_MIRROR_VIRTIOFSD=
#LYDIABOX_MIRROR_VIRTIOFSD_SHA256=
#LYDIABOX_MIRROR_MAGPIE=
#LYDIABOX_MIRROR_MAGPIE_SHA256=
#LYDIABOX_MIRROR_CLOUDFLARED=
#LYDIABOX_MIRROR_CLOUDFLARED_SHA256=

# --- Connectors -----------------------------------------------------------

# Optional cloud OAuth broker. When empty, the local OAuth clients below are used.
# yaml: oauth_relay_url                                default: empty
#LYDIABOX_OAUTH_RELAY_URL=

# Self-hosted OAuth applications. Register the callback URL
# http(s)://<your-host>/api/v1/connectors/<provider>/callback with each
# provider. Without a client, a Personal Access Token can be pasted in the UI.
# yaml: connectors.<provider>.client_id / client_secret
#LYDIABOX_GITHUB_CLIENT_ID=
#LYDIABOX_GITHUB_CLIENT_SECRET=
#LYDIABOX_GDRIVE_CLIENT_ID=
#LYDIABOX_GDRIVE_CLIENT_SECRET=
#LYDIABOX_NOTION_CLIENT_ID=
#LYDIABOX_NOTION_CLIENT_SECRET=
#LYDIABOX_SLACK_CLIENT_ID=
#LYDIABOX_SLACK_CLIENT_SECRET=

# --- Remote access: Cloudflare Zero Trust ---------------------------------
# `lydiabox cloudflare setup -hostname agent.example.com -email me@example.com`
# creates a Cloudflare Tunnel, its DNS record, and an Access application that
# allows only the given emails (one-time PIN login), and saves the tunnel
# token encrypted in the state database. `lydiabox up` then runs cloudflared
# and accepts the Access login. See README "Remote access with Cloudflare
# Zero Trust" and docs/remote-access-manual-test.md.

# API token and account of `lydiabox cloudflare setup|teardown` only; not
# needed by `lydiabox up`. Environment only (never in lydiabox.yaml).
# CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID also work.
# env only                                             default: empty
#LYDIABOX_CLOUDFLARE_API_TOKEN=
#LYDIABOX_CLOUDFLARE_ACCOUNT_ID=

# "auto" runs cloudflared when a tunnel is set up; "off" never runs it (for
# example when another container runs cloudflared). Access login stays on.
# yaml: remote_access.tunnel                           default: auto
#LYDIABOX_CLOUDFLARE_TUNNEL=auto

# Access settings. Each one replaces the value stored by
# `lydiabox cloudflare setup`; set all three for an Access application that
# you made yourself. Emails are comma separated; "@example.com" allows a
# domain. The audience (AUD) tag is on the application's Overview page.
# yaml: remote_access.access_team_domain, remote_access.access_aud,
#       remote_access.access_emails (list)             default: empty
#LYDIABOX_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
#LYDIABOX_ACCESS_AUD=
#LYDIABOX_ACCESS_EMAILS=me@example.com

# --- Guest daemon (set by LydiaBox; do not set on the host) ----------------
# The VMM driver passes these to `lydiabox-guest serve` inside the VM or
# container. They are listed so that every LYDIABOX_* variable the code reads
# is documented here.
#
# LYDIABOX_GUEST_LISTEN    guest RPC listener: vsock://:9000 (chv) or
#                          unix:///run/lydiabox/guest.sock (docker)
# LYDIABOX_HOST_ADDR       host connector broker: vsock://2:9001 or
#                          unix:///run/lydiabox/host-9001.sock
# LYDIABOX_GATEWAY_ADDR    host LLM gateway tunnel: vsock://2:9002 or
#                          unix:///run/lydiabox/host-9002.sock
# LYDIABOX_WEBRTC_UDP_PORT WebRTC UDP port (the host value above)
# LYDIABOX_CHROME_FLAGS    extra Chrome flags (docker: --no-sandbox)
# LYDIABOX_GATEWAY_TOKEN   placeholder gateway token (lydiabox-local) that the
#                          harness configs read; the host replaces it
# LYDIABOX_SESSION_ID, LYDIABOX_PTY_ID, LYDIABOX_HARNESS
#                          set in each harness PTY for the session in it
