# lydiabox-guest settings in the LydiaBox InstaBox image.
#
# The instabox driver writes this file to /data/.lydiabox/guest.env
# (mode 0600, owner UID 1000) with PUT /v1/machines/{id}/files before it
# needs the guest daemon; /usr/local/bin/lydiabox-instabox-guest waits for
# it and then starts `lydiabox-guest serve`. It is on the persistent disk,
# so it stays across stop and start. To change a value, the driver
# rewrites it and restarts the program through exec:
#   sudo supervisorctl -c /etc/lydiabox/instabox-supervisord.conf restart lydiabox-guest
#
# Format: KEY=VALUE lines, no quotes, no shell syntax. Only LYDIABOX_*
# keys are read; the file is never run as a script. It holds the link
# secret, never upstream LLM keys or refresh tokens. The daemon runs as
# UID 1000, so agent processes of that user can read the secret; the
# private port token keeps the link endpoint closed to the network.

# Host link listener of lydiabox-guest serve (rpc.EnvGuestListen,
# ws://<host>:<port>[/path]). The driver publishes the port as a private
# InstaBox port (1024-65535, not 5901 or 6768) and connects to
# wss://<port>-<machine id without m_>.<port domain>/ with
# Authorization: Bearer <port token>.
LYDIABOX_GUEST_LISTEN=ws://0.0.0.0:9000/

# Shared secret of the link, at least 16 bytes (internal/guest/link,
# EnvSecret). LYDIABOX_LINK_SECRET_FILE names a file with it instead.
# The daemon removes both from its environment after reading.
LYDIABOX_LINK_SECRET=

# In link mode the host broker and LLM gateway are local sockets that the
# daemon bridges to the link (defaults unix:///run/lydiabox/host-9001.sock
# and host-9002.sock; the entry point creates /run/lydiabox for UID 1000).
#LYDIABOX_HOST_ADDR=unix:///run/lydiabox/host-9001.sock
#LYDIABOX_GATEWAY_ADDR=unix:///run/lydiabox/host-9002.sock

# The two file roots of the guest file API (provider storage mode). The
# wrapper sets these defaults when the file leaves them out;
# LYDIABOX_GUEST_WORKSPACE_ROOT is also the default PTY directory.
LYDIABOX_GUEST_HOME_ROOT=/data/home
LYDIABOX_GUEST_WORKSPACE_ROOT=/data/workspace

# UDP port of the WebRTC desktop stream (rpc.EnvWebRTCPort). InstaBox
# documents no inbound UDP, so the stream relays through TURN only: 0.
LYDIABOX_WEBRTC_UDP_PORT=0

# Optional: log level and extra Chrome flags.
LYDIABOX_LOG_LEVEL=info
#LYDIABOX_CHROME_FLAGS=
