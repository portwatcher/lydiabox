#!/bin/sh
# PID 1 of the machine-model test image (deploy/instabox/machine-model):
# does what the InstaBox machine does before instabox-image.service, then
# runs the image's entry point with the unit's environment and a socket as
# its standard output.
set -eu

# The lingering user manager of UID 1000 runs the session bus.
mkdir -p /run/user/1000
chown 1000:1000 /run/user/1000
chmod 0700 /run/user/1000
rm -f /run/user/1000/bus
setpriv --reuid=1000 --regid=1000 --init-groups \
	dbus-daemon --session --address=unix:path=/run/user/1000/bus --fork --nopidfile

# The unit gets the image ENV without HOME.
unset HOME
exec /usr/local/sbin/instabox-model-stdout-socket /usr/local/sbin/lydiabox-instabox-entry "$@"
