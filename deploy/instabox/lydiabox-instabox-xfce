#!/bin/sh
# Starts the Xfce session of the LydiaBox InstaBox image as the machine
# user (UID 1000), on a session D-Bus of its own.
#
# The session needs its own bus. On InstaBox the machine user lingers and
# its systemd user manager runs a session bus at $XDG_RUNTIME_DIR/bus, but
# that bus starts D-Bus activated services (xfconfd, which reads and
# writes the Xfce settings) with the user manager's environment: HOME is
# InstaBox's /data/home, not /home/agent. The dbus-run-session of an
# Ubuntu-based image cannot run there (it needs LIBDBUS_PRIVATE_1.14.10 of
# the image's libdbus, but the machine keeps its own, newer libdbus), so
# this program runs dbus-daemon itself (the machine's on InstaBox) for the
# life of startxfce4, with this program's environment. This also works
# with the Debian 13 image.
set -eu

log() { echo "lydiabox-instabox-xfce: $*" >&2; }

# Xvfb starts at the same time; Xfce needs its socket.
dnum=${DISPLAY:-:0}
dnum=${dnum#:}
dnum=${dnum%%.*}
i=0
while [ ! -S "/tmp/.X11-unix/X$dnum" ] && [ "$i" -lt 30 ]; do
	sleep 1
	i=$((i + 1))
done

runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
sock=$runtime/lydiabox-session-bus
rm -f "$sock"
dbus-daemon --session --nofork --nopidfile --address="unix:path=$sock" &
bus=$!
i=0
while [ ! -S "$sock" ] && [ "$i" -lt 20 ]; do
	if ! kill -0 "$bus" 2>/dev/null; then
		log "ERROR: dbus-daemon --session exited"
		exit 1
	fi
	sleep 0.5
	i=$((i + 1))
done
if [ ! -S "$sock" ]; then
	log "ERROR: no session bus at $sock"
	kill "$bus" 2>/dev/null || true
	exit 1
fi
export DBUS_SESSION_BUS_ADDRESS="unix:path=$sock"
log "session bus $sock (HOME $HOME)"

startxfce4 &
xfce=$!
# shellcheck disable=SC2329 # called by the trap
stop() {
	kill -TERM "$xfce" 2>/dev/null || true
}
trap stop TERM INT HUP
status=0
wait "$xfce" || status=$?
# A signal interrupts the first wait; wait for the session to end.
if kill -0 "$xfce" 2>/dev/null; then
	wait "$xfce" || status=$?
fi
kill -TERM "$bus" 2>/dev/null || true
wait "$bus" 2>/dev/null || true
exit "$status"
